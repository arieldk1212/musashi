{
	"folders":
	[
		{
			"path": ".",
		}
	],
	"cmake":
	{
   		"build_folder": "${project_path}/build",
	},
	"debugger_configurations":
	[
		{
			"type": "lldb",
			"request": "launch",
			"name": "Launch",
			"program": "${project_path}/build/src/main",
			"args": [],
			"cwd": "${project_path}",
			"terminal": "console",
		},
	],
	"build_systems":
	[
		{
			"name": "Run",
    		"shell_cmd": "./build/src/main",
    		"working_dir": "${project_path}",
		},
		{
			"name": "Run with Build",
    		"shell_cmd": "cmake -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build -j8 && ./build/src/main",
    		"working_dir": "${project_path}",
		},
		{
			"name": "Debug Build",
			"shell_cmd": "cmake -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build -j8",
			"working_dir": "${project_path}",
		},
		{
			"name": "Release Build",
			"shell_cmd": "cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j8",
			"working_dir": "${project_path}",
		},
		{
			"name": "Clear Build",
			"shell_cmd": "rm -rf build",
			"working_dir": "${project_path}",
		},
	],
}
