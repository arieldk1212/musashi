{
	"folders":
	[
		{
			"path": ".",
		}
	],
	"cmake":
	{
   		"build_folder": "${project_path}/build",
	},
	"debugger_configurations":
	[
		{
			"type": "lldb",
			"request": "launch",
			"name": "Launch",
			"program": "${project_path}/build/src/main",
			"args": [],
			"cwd": "${project_path}",
			"terminal": "console",
		},
	],
	"build_systems":
	[
		{
			"name": "Run",
    		"shell_cmd": "./build/src/main",
    		"working_dir": "${project_path}",
		},
		{
			"name": "Debug Build",
			"shell_cmd": "cmake -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build -j8",
			"working_dir": "${project_path}",
		},
		{
		    "name": "Debug Build (with ASan)",
		    "shell_cmd": "cmake -B build -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS='-g -fsanitize=address -fno-omit-frame-pointer' -DCMAKE_EXE_LINKER_FLAGS='-fsanitize=address' && cmake --build build -j8",
		    "working_dir": "${project_path}",
		    "env": {
		        "ASAN_OPTIONS": "detect_leaks=1:symbolize=1:check_initialization_order=true"
		    }
		},
		{
			"name": "Release Build",
			"shell_cmd": "cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j8",
			"working_dir": "${project_path}",
		},
		{
			"name": "Clear Build",
			"shell_cmd": "rm -rf build",
			"working_dir": "${project_path}",
		},
	],
}
